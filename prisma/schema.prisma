datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth standard models adapted for Household Sharing
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Custom Household Tenant model
model Household {
  id            String              @id @default(cuid())
  name          String              @default("Our Home")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  
  // Relations
  users         User[]
  prayerLogs    PrayerLog[]
  tasks         Task[]
  reminders     Reminder[]
  bills         Bill[]
  expenses      Expense[]
  savingsGoals  SavingsGoal[]
  groceryItems  GroceryItem[]
  workoutLogs   WorkoutLog[]
  nutritionLogs DailyNutritionLog[]
  networkLogs   NetworkLog[]
  vaultItems    VaultItem[]
  mealPlans     MealPlan[]
}

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String?             @unique
  emailVerified DateTime?
  image         String?
  role          String?             // "HUSBAND" or "WIFE"
  
  householdId   String
  household     Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  // NextAuth relations
  accounts      Account[]
  sessions      Session[]
  
  // Custom relations
  prayerLogs    PrayerLog[]
  assignedTasks Task[]              @relation("AssignedTasks")
  expenses      Expense[]
  workoutLogs   WorkoutLog[]
  nutritionLogs DailyNutritionLog[]
  
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

// 2. Spiritual Tracker
model PrayerLog {
  id          String    @id @default(cuid())
  date        DateTime  // Just date component (YYYY-MM-DD)
  prayerName  String    // "FAJR", "DHUHR", "ASR", "MAGHRIB", "ISHA"
  completed   Boolean   @default(false)
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([date, prayerName, userId])
}

// 3. Task & Reminder Engine
model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  urgency      String    // "HIGH", "MEDIUM", "LOW"
  category     String    // "Groceries", "Home Maintenance", "Admin", etc.
  status       String    // "TODO", "IN_PROGRESS", "DONE"
  dueDate      DateTime?
  completedAt  DateTime?
  
  assignedToId String?
  assignedTo   User?     @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Reminder {
  id             String    @id @default(cuid())
  title          String
  description    String?
  frequency      String    // "DAILY", "WEEKLY", "MONTHLY", "ANNUALLY"
  dayOfWeek      Int?      // 0-6 (Sunday-Saturday), for weekly
  dayOfMonth     Int?      // 1-31, for monthly
  startDate      DateTime
  lastTriggered  DateTime?
  nextDueDate    DateTime
  
  householdId    String
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// 4. Finance & Bills Manager
model Bill {
  id          String    @id @default(cuid())
  name        String
  amount      Float
  dueDate     DateTime
  frequency   String    // "ONCE", "MONTHLY", "YEARLY"
  paid        Boolean   @default(false)
  category    String    // "Utilities", "Rent", "Subscription", etc.
  
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id          String    @id @default(cuid())
  description String
  amount      Float
  date        DateTime
  category    String    // "Food", "Transport", "Shopping", etc.
  
  loggedById  String
  loggedBy    User      @relation(fields: [loggedById], references: [id], onDelete: Cascade)
  
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SavingsGoal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0.0)
  targetDate    DateTime?
  
  householdId   String
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// 5. Extras: Grocery, Fitness, Network, Vault & Meals
model GroceryItem {
  id          String    @id @default(cuid())
  name        String
  quantity    String?   // e.g., "3x", "2 liters"
  checked     Boolean   @default(false)
  category    String    @default("General") // "Produce", "Dairy", etc.
  
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WorkoutLog {
  id          String    @id @default(cuid())
  date        DateTime
  activity    String    // "Gym", "Cardio", "Planks", etc.
  duration    Int?      // In minutes
  notes       String?
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DailyNutritionLog {
  id           String    @id @default(cuid())
  date         DateTime
  proteinGrams Int       @default(0)
  calorieIntake Int      @default(0)
  
  proteinGoal  Int       @default(120)
  calorieGoal  Int       @default(2000)
  
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([date, userId])
}

model NetworkLog {
  id                 String    @id @default(cuid())
  contactName        String    // e.g., "Mom & Dad"
  relation           String    // e.g., "Husband's Parents", "Wife's Parents"
  lastContacted      DateTime
  frequencyDays      Int       @default(30) // Reminder frequency (e.g. check in every 30 days)
  nextContactDueDate DateTime
  notes              String?
  
  householdId        String
  household          Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model VaultItem {
  id               String    @id @default(cuid())
  documentName     String    // e.g., "House Contract", "Passport Copies"
  physicalLocation String    // e.g., "Master Bedroom safe, Shelf 2"
  referenceNumber  String?   // e.g., Policy ID, Document Number
  expiryDate       DateTime?
  notes            String?
  
  householdId      String
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model MealPlan {
  id          String    @id @default(cuid())
  date        DateTime  // Day of the meal plan
  mealType    String    // "BREAKFAST", "LUNCH", "DINNER", "SNACK"
  recipeName  String    // e.g., "Chicken Curry", "Oatmeal"
  notes       String?
  
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([date, mealType, householdId])
}